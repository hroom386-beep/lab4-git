name: Run Custom Bash Script

on:
  push:
    branches: [ "main" ] # Скрипт будет запускаться при пуше в main
  workflow_dispatch:     # Позволит запускать workflow вручную через сайт GitHub

jobs:
  run-script:
    runs-on: ubuntu-latest

    steps:
      # 1. Скачиваем файлы репозитория на раннер (обязательно для доступа к скрипту)
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2. Выдаем права на исполнение скрипту
      - name: Make script executable
        run: chmod +x scripts/build.sh

      # 3. Запускаем сам Bash-скрипт
      - name: Run build script
        run: ./scripts/build.sh

      # 4. Выводим содержимое созданного файла в консоль (логи)
      - name: Display build info content
        run: cat build_info.txt
